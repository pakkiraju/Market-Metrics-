# FinViz Elite API (required for export.ashx CSV data - screeners, Qullamaggie, etc.)
# Copy to .env and fill in your credentials.

# Option 1: API key (from your Elite account / api_explanation.ashx) - recommended for export.ashx
FINVIZ_API_KEY=YOUR_API_KEY_HERE

# Option 2: Email + password (cookie-based auth)
# FINVIZ_EMAIL=your@email.com
# FINVIZ_PASSWORD=your_password

# Stockbee API (optional - for Stock Market Breadth from Stockbee Dashboard api_server)
# STOCKBEE_API_URL=http://localhost:8000
