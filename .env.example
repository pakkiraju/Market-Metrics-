# FinViz Elite API (required for export.ashx CSV data - screeners, Qullamaggie, etc.)
# Copy to .env and fill in your credentials.

FINVIZ_API_KEY=YOUR_API_KEY_HERE

# Optional: tune FinViz pacing (default delay 1.25s between sequential calls)
# FINVIZ_DELAY_SEC=1.25
# Optional: parallel multi-screener fetches (2+); may increase 429 risk — default 0 = sequential
# FINVIZ_PARALLEL_WORKERS=0

# Option 2: Email + password (cookie-based auth)
FINVIZ_EMAIL=EMAIL_HERE
FINVIZ_PASSWORD=PASSWORD_HERE


# St. Louis Fed — Macro Monitor tab (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=YOUR_FRED_KEY_HERE