# FinViz Elite API (optional - enables real-time data instead of 15-20 min delay)
# Copy to .env and fill in your credentials.

# Option 1: API key (from your Elite account / api_explanation.ashx)
FINVIZ_API_KEY=YOUR_API_KEY_HERE

# Option 2: Email + password (cookie-based auth)
# FINVIZ_EMAIL=your@email.com
# FINVIZ_PASSWORD=your_password
